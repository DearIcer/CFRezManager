<Window x:Class="CFRezManager.ModelPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Preview"
        Width="980"
        Height="720"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBrush}">
    <DockPanel Background="{DynamicResource AppWindowBrush}">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSurfaceAltBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PreviewInfoText"
                           Foreground="{DynamicResource AppTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel x:Name="AnimationPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Margin="0,0,12,0">
                    <TextBlock x:Name="AnimationLabelText"
                               Foreground="{DynamicResource AppSubtleTextBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <ComboBox x:Name="AnimationComboBox"
                              MinWidth="140"
                              FontSize="11"
                              VerticalContentAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ShortcutHintText"
                           Grid.Column="2"
                           Foreground="{DynamicResource AppSubtleTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border x:Name="PlaybackPanel"
                DockPanel.Dock="Bottom"
                Background="{DynamicResource AppSurfaceAltBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,7"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPauseButton"
                        Padding="12,3"
                        FontSize="11"
                        VerticalAlignment="Center"
                        Click="PlayPauseButton_Click"/>
                <Slider x:Name="PlaybackSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="1"
                        VerticalAlignment="Center"
                        Margin="10,0"
                        IsMoveToPointEnabled="True"
                        PreviewMouseLeftButtonDown="PlaybackSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="PlaybackSlider_PreviewMouseLeftButtonUp"/>
                <TextBlock x:Name="PlaybackTimeText"
                           Grid.Column="2"
                           Foreground="{DynamicResource AppSubtleTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Text="0.00 / 0.00"/>
            </Grid>
        </Border>

        <Grid x:Name="ViewerContainer" ClipToBounds="True">
            <TextBlock x:Name="ViewerStatusText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       FontSize="13"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="24"/>
        </Grid>
    </DockPanel>
</Window>
